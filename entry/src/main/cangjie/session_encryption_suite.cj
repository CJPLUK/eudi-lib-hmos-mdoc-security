// @consolidated-test (generated by consolidate_tests.py)
/*
 * session_encryption_test.cj — unit tests for ISO 18013-5 §9.1.1 session encryption.
 *
 * Verifies the three done_when acceptance criteria:
 *   ① HKDF session key derivation with synthetic shared secret (no HUKS required).
 *   ② AES-GCM nonce counter + seal/open round-trip.
 *   ③ SessionTranscript / SessionEstablishment / SessionData CBOR round-trips.
 *
 * EcdhP256.agree() calls HUKS which is unavailable on the host build target.
 * Tests that would invoke HUKS are scoped to HKDF-only paths using synthetic
 * shared secrets, consistent with the approach used in upstream mdoc tests.
 */
package ohos_app_cangjie_entry
import std.unittest.*
import std.unittest.testmacro.*

import ohos_app_cangjie_eudi_cjmdoc_security.security.session.SessionEncryption
import ohos_app_cangjie_eudi_cjmdoc_security.security.session.SessionTranscript
import ohos_app_cangjie_eudi_cjmdoc_security.security.session.SessionEstablishment
import ohos_app_cangjie_eudi_cjmdoc_security.security.session.SessionData
import ohos_app_cangjie_eudi_cjmdoc_security.security.session.SessionRole

import eudi_lib_core_crypto.AesGcm
import eudi_lib_core_crypto.Hkdf

/* ------------------------------------------------------------------ */
/* Helpers                                                              */
/* ------------------------------------------------------------------ */

func bytesEqualSess(a: Array<UInt8>, b: Array<UInt8>): Bool {
    if (a.size != b.size) {
        return false
    }
    var i: Int64 = 0
    while (i < a.size) {
        if (a[i] != b[i]) { return false }
        i += 1
    }
    return true
}

func syntheticSharedSecret(): Array<UInt8> {
    return Array<UInt8>(32, repeat: UInt8(0xAB))
}

func sampleDevEngBytes(): Array<UInt8> {
    return Array<UInt8>(16, repeat: UInt8(0xDE))
}

func sampleEReaderBytes(): Array<UInt8> {
    return Array<UInt8>(16, repeat: UInt8(0xEE))
}

/* A minimal synthetic handover: CBOR null byte (0xF6). */
let HANDOVER_NULL: Array<UInt8> = [0xF6u8]

/* ------------------------------------------------------------------ */
/* Test suite: done_when ③ — CBOR round-trips                          */
/* ------------------------------------------------------------------ */

@Test
class SessionCborTests {

    /**
     * done_when ③: SessionTranscript.toCborBytes() produces CBOR array(3)
     * starting with 0x83, with tag-24 wrappers for devEng and eReaderKey.
     */
    @TestCase
    func testSessionTranscriptToCborBytes(): Unit {
        let devEngBytes = sampleDevEngBytes()
        let eReaderBytes = sampleEReaderBytes()
        let st = SessionTranscript(Some(devEngBytes), Some(eReaderBytes), HANDOVER_NULL)
        let encoded = st.toCborBytes()
        // Must be non-empty
        @Expect(encoded.size > 0, true)
        // First byte: CBOR array(3) = 0x83
        @Expect(encoded[0], UInt8(0x83))
        // Second element starts with tag-24: 0xD8 0x18
        @Expect(encoded[1], UInt8(0xD8))
        @Expect(encoded[2], UInt8(0x18))
    }

    /**
     * done_when ③: SessionTranscript with None fields encodes null (0xF6).
     */
    @TestCase
    func testSessionTranscriptNullFields(): Unit {
        let st = SessionTranscript(None, None, HANDOVER_NULL)
        let encoded = st.toCborBytes()
        @Expect(encoded[0], UInt8(0x83))  // array(3)
        @Expect(encoded[1], UInt8(0xF6))  // null for devEng
        @Expect(encoded[2], UInt8(0xF6))  // null for eReaderKey
    }

    /**
     * done_when ③: SessionTranscript.toTaggedBytes() wraps the inner bytes in tag-24.
     * Expected: 0xD8 0x18 <bstr(toCborBytes())>
     */
    @TestCase
    func testSessionTranscriptTaggedBytes(): Unit {
        let st = SessionTranscript(Some(sampleDevEngBytes()), Some(sampleEReaderBytes()), HANDOVER_NULL)
        let inner = st.toCborBytes()
        let tagged = st.toTaggedBytes()
        @Expect(tagged.size > inner.size + 2, true)
        @Expect(tagged[0], UInt8(0xD8))
        @Expect(tagged[1], UInt8(0x18))
    }

    /**
     * done_when ③: SessionEstablishment CBOR round-trip.
     * toCborBytes → fromCborBytes restores all fields.
     */
    @TestCase
    func testSessionEstablishmentRoundtrip(): Unit {
        let eReaderKeyRaw: Array<UInt8> = [0x0Au8, 0x0Bu8, 0x0Cu8, 0x0Du8, 0x0Eu8]
        let encryptedData: Array<UInt8> = [0xAAu8, 0xBBu8, 0xCCu8, 0xDDu8]
        let se = SessionEstablishment(Some(eReaderKeyRaw), encryptedData)
        let encoded = se.toCborBytes()
        @Expect(encoded.size > 0, true)
        let decoded = SessionEstablishment.fromCborBytes(encoded)
        @Expect(bytesEqualSess(decoded.data, encryptedData), true)
        let decodedKey: Array<UInt8> = match (decoded.eReaderKeyRawData) {
            case Some(k) => k
            case None =>
                @Fail("eReaderKeyRawData should not be None after round-trip")
                return
        }
        @Expect(bytesEqualSess(decodedKey, eReaderKeyRaw), true)
    }

    /**
     * done_when ③: SessionEstablishment with no eReaderKey round-trips.
     */
    @TestCase
    func testSessionEstablishmentNoKeyRoundtrip(): Unit {
        let encryptedData: Array<UInt8> = [0x11u8, 0x22u8, 0x33u8]
        let se = SessionEstablishment(None, encryptedData)
        let encoded = se.toCborBytes()
        let decoded = SessionEstablishment.fromCborBytes(encoded)
        @Expect(bytesEqualSess(decoded.data, encryptedData), true)
        @Expect(decoded.eReaderKeyRawData.isNone(), true)
    }

    /**
     * done_when ③: SessionData with both data and status round-trips.
     */
    @TestCase
    func testSessionDataBothFieldsRoundtrip(): Unit {
        let cipherData: Array<UInt8> = [0xAAu8, 0xBBu8, 0xCCu8]
        let status: UInt64 = 20
        let sd = SessionData(Some(cipherData), Some(status))
        let encoded = sd.toCborBytes()
        @Expect(encoded.size > 0, true)
        let decoded = SessionData.fromCborBytes(encoded)
        let decodedData: Array<UInt8> = match (decoded.data) {
            case Some(d) => d
            case None =>
                @Fail("data should not be None")
                return
        }
        @Expect(bytesEqualSess(decodedData, cipherData), true)
        let decodedStatus: UInt64 = match (decoded.status) {
            case Some(s) => s
            case None =>
                @Fail("status should not be None")
                return
        }
        @Expect(decodedStatus, status)
    }

    /**
     * done_when ③: SessionData.withData round-trip (status=None).
     */
    @TestCase
    func testSessionDataWithDataRoundtrip(): Unit {
        let cipherData: Array<UInt8> = [0x10u8, 0x20u8, 0x30u8]
        let sd = SessionData.withData(cipherData)
        let encoded = sd.toCborBytes()
        let decoded = SessionData.fromCborBytes(encoded)
        let decodedData: Array<UInt8> = match (decoded.data) {
            case Some(d) => d
            case None =>
                @Fail("data should not be None")
                return
        }
        @Expect(bytesEqualSess(decodedData, cipherData), true)
        match (decoded.status) {
            case None => ()
            case Some(_) => @Fail("status should be None when not set")
        }
    }

    /**
     * done_when ③: SessionData.withStatus round-trip (data=None).
     */
    @TestCase
    func testSessionDataWithStatusRoundtrip(): Unit {
        let sd = SessionData.withStatus(UInt64(20))
        let encoded = sd.toCborBytes()
        let decoded = SessionData.fromCborBytes(encoded)
        @Expect(decoded.data.isNone(), true)
        let decodedStatus: UInt64 = match (decoded.status) {
            case Some(s) => s
            case None =>
                @Fail("status should not be None")
                return
        }
        @Expect(decodedStatus, UInt64(20))
    }
}

/* ------------------------------------------------------------------ */
/* Test suite: done_when ① — HKDF session key derivation               */
/* ------------------------------------------------------------------ */

@Test
class SessionHkdfTests {

    /**
     * done_when ①: HKDF.derive is deterministic — same inputs → same output.
     * Validates the SKDevice key derivation path.
     */
    @TestCase
    func testHkdfDeriveIsDeterministic(): Unit {
        let sharedSecret = syntheticSharedSecret()
        let salt = Array<UInt8>(10, repeat: UInt8(0x01))
        // "SKDevice" UTF-8
        let infoDevice: Array<UInt8> = [0x53u8, 0x4Bu8, 0x44u8, 0x65u8, 0x76u8, 0x69u8, 0x63u8, 0x65u8]
        // "SKReader" UTF-8
        let infoReader: Array<UInt8> = [0x53u8, 0x4Bu8, 0x52u8, 0x65u8, 0x61u8, 0x64u8, 0x65u8, 0x72u8]

        let skDevice1 = SessionEncryption.hkdfDeriveKey(sharedSecret, salt, infoDevice)
        let skDevice2 = SessionEncryption.hkdfDeriveKey(sharedSecret, salt, infoDevice)
        let skReader  = SessionEncryption.hkdfDeriveKey(sharedSecret, salt, infoReader)

        @Expect(skDevice1.size, 32)
        @Expect(skReader.size, 32)
        // Determinism
        @Expect(bytesEqualSess(skDevice1, skDevice2), true)
        // Different info → different keys
        @Expect(bytesEqualSess(skDevice1, skReader), false)
    }

    /**
     * done_when ①: SKDevice ≠ SKReader for same shared secret and salt.
     */
    @TestCase
    func testSKDeviceAndSKReaderAreDifferent(): Unit {
        let sharedSecret = syntheticSharedSecret()
        let salt = sampleDevEngBytes()
        let infoDevice: Array<UInt8> = [0x53u8, 0x4Bu8, 0x44u8, 0x65u8, 0x76u8, 0x69u8, 0x63u8, 0x65u8]
        let infoReader: Array<UInt8> = [0x53u8, 0x4Bu8, 0x52u8, 0x65u8, 0x61u8, 0x64u8, 0x65u8, 0x72u8]
        let skDevice = SessionEncryption.hkdfDeriveKey(sharedSecret, salt, infoDevice)
        let skReader  = SessionEncryption.hkdfDeriveKey(sharedSecret, salt, infoReader)
        @Expect(bytesEqualSess(skDevice, skReader), false)
    }

    /**
     * done_when ①: Different shared secrets → different derived keys.
     */
    @TestCase
    func testDifferentSharedSecretsYieldDifferentKeys(): Unit {
        let secret1 = syntheticSharedSecret()
        let secret2 = Array<UInt8>(32, repeat: UInt8(0xCD))
        let salt = Array<UInt8>(32, repeat: UInt8(0x00))
        let infoDevice: Array<UInt8> = [0x53u8, 0x4Bu8, 0x44u8, 0x65u8, 0x76u8, 0x69u8, 0x63u8, 0x65u8]
        let k1 = SessionEncryption.hkdfDeriveKey(secret1, salt, infoDevice)
        let k2 = SessionEncryption.hkdfDeriveKey(secret2, salt, infoDevice)
        @Expect(bytesEqualSess(k1, k2), false)
    }
}

/* ------------------------------------------------------------------ */
/* Test suite: done_when ② — AES-GCM nonce + encrypt/decrypt round-trip */
/* ------------------------------------------------------------------ */

@Test
class SessionAesGcmTests {

    /**
     * done_when ②: seal → open recovers original plaintext.
     */
    @TestCase
    func testAesGcmSealOpenRoundtrip(): Unit {
        let key = Array<UInt8>(32, repeat: UInt8(0x42))
        let nonce = Array<UInt8>(12, repeat: UInt8(0x05))
        let aad = Array<UInt8>()
        let plaintext: Array<UInt8> = [0x01u8, 0x02u8, 0x03u8, 0x04u8, 0x05u8]
        let ciphertext = AesGcm.seal(key, nonce, aad, plaintext)
        // Ciphertext must include 16-byte GCM tag
        @Expect(ciphertext.size, plaintext.size + 16)
        let recovered: Array<UInt8> = match (AesGcm.open(key, nonce, aad, ciphertext)) {
            case Some(p) => p
            case None =>
                @Fail("AES-GCM open failed with matching nonce and key")
                return
        }
        @Expect(bytesEqualSess(recovered, plaintext), true)
    }

    /**
     * done_when ②: Nonce counter increments produce distinct ciphertexts.
     * Two encryptions with different counters (same key + same plaintext) must differ.
     */
    @TestCase
    func testCounterIncrementProducesDifferentCiphertexts(): Unit {
        let key = Array<UInt8>(32, repeat: UInt8(0x77))
        let aad = Array<UInt8>()
        let plaintext: Array<UInt8> = [0xAAu8, 0xBBu8, 0xCCu8]
        // Nonce with IDENTIFIER1 prefix and counter=1
        let nonce1 = Array<UInt8>(12, repeat: 0)
        nonce1[7] = UInt8(0x01)   // IDENTIFIER1 last byte
        nonce1[11] = UInt8(0x01)  // counter=1
        // Nonce with counter=2
        let nonce2 = Array<UInt8>(12, repeat: 0)
        nonce2[7] = UInt8(0x01)   // IDENTIFIER1 last byte
        nonce2[11] = UInt8(0x02)  // counter=2
        let ct1 = AesGcm.seal(key, nonce1, aad, plaintext)
        let ct2 = AesGcm.seal(key, nonce2, aad, plaintext)
        @Expect(bytesEqualSess(ct1, ct2), false)
    }

    /**
     * done_when ②: mdoc role: encrypt uses IDENTIFIER1, decrypt uses IDENTIFIER0.
     * Encrypt nonce and decrypt nonce must differ.
     */
    @TestCase
    func testMdocEncryptDecryptNonceDiffer(): Unit {
        // IDENTIFIER1 = [0,0,0,0,0,0,0,1]; IDENTIFIER0 = [0,0,0,0,0,0,0,0]
        let nonceEnc = Array<UInt8>(12, repeat: 0)
        nonceEnc[7] = UInt8(0x01)   // IDENTIFIER1
        nonceEnc[11] = UInt8(0x01)  // counter=1
        let nonceDec = Array<UInt8>(12, repeat: 0)
        // IDENTIFIER0 = all zeros; counter=1
        nonceDec[11] = UInt8(0x01)
        // Must differ (different identifier part)
        @Expect(bytesEqualSess(nonceEnc, nonceDec), false)
        // GCM seal with encrypt nonce; decrypt nonce does NOT match → open returns None
        let key = Array<UInt8>(32, repeat: UInt8(0xAA))
        let aad = Array<UInt8>()
        let pt: Array<UInt8> = [0x01u8, 0x02u8]
        let ct = AesGcm.seal(key, nonceEnc, aad, pt)
        let result = AesGcm.open(key, nonceDec, aad, ct)
        // Wrong nonce → authentication failure → None
        @Expect(result.isNone(), true)
    }

    /**
     * done_when ②: Wrong key returns None (authentication failure).
     */
    @TestCase
    func testAesGcmWrongKeyReturnsNone(): Unit {
        let key = Array<UInt8>(32, repeat: UInt8(0x42))
        let wrongKey = Array<UInt8>(32, repeat: UInt8(0x99))
        let nonce = Array<UInt8>(12, repeat: UInt8(0x05))
        let aad = Array<UInt8>()
        let plaintext: Array<UInt8> = [0xDEu8, 0xADu8, 0xBEu8, 0xEFu8]
        let ciphertext = AesGcm.seal(key, nonce, aad, plaintext)
        let result = AesGcm.open(wrongKey, nonce, aad, ciphertext)
        match (result) {
            case None => ()
            case Some(_) => @Fail("Expected None for wrong key, got Some")
        }
    }
}
