/* ------------------------------------------------------------------ */
/* Local helpers                                                       */
/* ------------------------------------------------------------------ */

func bytesEqualCx(a: Array<UInt8>, b: Array<UInt8>): Bool {
    if (a.size != b.size) { return false }
    var i: Int64 = 0
    while (i < a.size) {
        if (a[i] != b[i]) { return false }
        i += 1
    }
    return true
}

/* Synthetic P-256 coordinates (32 bytes each) — wire-shape only, not on-curve.
 * forMdoc / sessionTranscript only move raw bytes around; they never run EC math,
 * so non-curve coordinates are fine for these structural assertions. */
func sampleX(): Array<UInt8> {
    return Array<UInt8>(32, repeat: UInt8(0x11))
}

func sampleY(): Array<UInt8> {
    return Array<UInt8>(32, repeat: UInt8(0x22))
}

let CX_HANDOVER_NULL: Array<UInt8> = [0xF6u8]

func sampleEReaderRaw(): Array<UInt8> {
    return Array<UInt8>(8, repeat: UInt8(0xEE))
}

func sampleDevEngRaw(): Array<UInt8> {
    return Array<UInt8>(8, repeat: UInt8(0xDE))
}

func buildSessionEncryption(): SessionEncryption {
    let eReaderKey = CoseKey(EngCoseEcCurve.P256, sampleX(), sampleY())
    let devicePriv = CoseKeyPrivate(None, "test-alias", EngCoseEcCurve.P256)
    return SessionEncryption.forMdoc(
        eReaderKey,
        sampleEReaderRaw(),
        devicePriv,
        sampleDevEngRaw(),
        CX_HANDOVER_NULL
    )
}

/* ================================================================== */
/* SessionEncryption.forMdoc / sessionTranscript / sessionTranscriptBytes */
/* ================================================================== */

@Test
class SessionEncryptionFactoryTests {

    /**
     * forMdoc wires the peer public key and device private key into the
     * CoseKeyExchange, and seeds the raw DE / eReader bytes + handover.
     */
    @TestCase
    func testForMdocWiresKeysAndRawData(): Unit {
        let se = buildSessionEncryption()

        // counter starts at 1 per ISO 18013-5 §9.1.1.5
        @Expect(se.sessionCounter, UInt32(1))
        // raw bytes passed through verbatim
        @Expect(bytesEqualCx(se.eReaderKeyRawData, sampleEReaderRaw()), true)
        @Expect(bytesEqualCx(se.deviceEngagementRawData, sampleDevEngRaw()), true)
        @Expect(bytesEqualCx(se.handOverBytes, CX_HANDOVER_NULL), true)
        // peer public key was wired into the exchange (Some)
        @Expect(se.sessionKeys.publicKey.isSome(), true)
        // private key alias preserved
        @Expect(se.sessionKeys.privateKey.privateKeyId, "test-alias")
    }

    /**
     * sessionTranscript() rebuilds a SessionTranscript whose CBOR matches one
     * built directly from the same raw bytes — confirming the instance method
     * feeds the exact DE/eReader/handover triple.
     */
    @TestCase
    func testSessionTranscriptMatchesDirectConstruction(): Unit {
        let se = buildSessionEncryption()
        let stFromSe: SessionTranscript = se.sessionTranscript()

        let stDirect = SessionTranscript(
            Some(sampleDevEngRaw()),
            Some(sampleEReaderRaw()),
            CX_HANDOVER_NULL
        )
        @Expect(bytesEqualCx(stFromSe.toCborBytes(), stDirect.toCborBytes()), true)
        // ST is a CBOR array(3) → first byte 0x83
        @Expect(stFromSe.toCborBytes()[0], UInt8(0x83))
    }

    /**
     * sessionTranscriptBytes() == Tag24(sessionTranscript().toCborBytes()).
     * This is the HKDF salt; assert the Tag24 wrapper (0xD8 0x18) and that it
     * equals the transcript's own toTaggedBytes().
     */
    @TestCase
    func testSessionTranscriptBytesIsTag24OfTranscript(): Unit {
        let se = buildSessionEncryption()
        let salt = se.sessionTranscriptBytes()
        let expected = se.sessionTranscript().toTaggedBytes()

        @Expect(salt.size > 2, true)
        @Expect(salt[0], UInt8(0xD8))
        @Expect(salt[1], UInt8(0x18))
        @Expect(bytesEqualCx(salt, expected), true)
    }

    /**
     * The session transcript bytes are usable as a real HKDF salt: deriving an
     * EMacKey with them yields a deterministic 32-byte key (offline HKDF path).
     */
    @TestCase
    func testSessionTranscriptBytesUsableAsHkdfSalt(): Unit {
        let se = buildSessionEncryption()
        let salt = se.sessionTranscriptBytes()
        let secret = Array<UInt8>(32, repeat: UInt8(0xAB))
        let k1 = MdocAuthentication.deriveEMacKey(secret, salt)
        let k2 = MdocAuthentication.deriveEMacKey(secret, salt)
        @Expect(k1.size, 32)
        @Expect(bytesEqualCx(k1, k2), true)
    }
}

/* ================================================================== */
/* CoseMac0.toCborArray — CBOR value shape                            */
/* ================================================================== */

@Test
class CoseMac0CborArrayTests {

    /**
     * toCborArray() returns a 4-element CBOR array:
     *   [bstr(protected), {} (empty map), null (detached payload), bstr(tag)].
     */
    @TestCase
    func testToCborArrayShape(): Unit {
        let payload: Array<UInt8> = [0x01u8, 0x02u8, 0x03u8]
        let emacKey = Array<UInt8>(32, repeat: UInt8(0x42))
        let mac0 = MdocAuthentication.makeDetachedCoseMac0(payload, emacKey)

        let arr: CborValue = mac0.toCborArray()
        match (arr) {
            case CborValue.ArrayVal(items) =>
                @Expect(items.size, 4)
                // [0] protected header bytes (bstr)
                match (items[0]) {
                    case CborValue.ByteStringVal(b) =>
                        @Expect(bytesEqualCx(b, mac0.protectedHeaderBytes), true)
                    case _ => @Fail("items[0] should be ByteStringVal(protected)")
                }
                // [1] empty unprotected header map
                match (items[1]) {
                    case CborValue.MapVal(pairs) => @Expect(pairs.size, 0)
                    case _ => @Fail("items[1] should be MapVal({})")
                }
                // [2] detached payload = null
                match (items[2]) {
                    case CborValue.NullVal => ()
                    case _ => @Fail("items[2] should be NullVal")
                }
                // [3] 32-byte MAC tag (bstr)
                match (items[3]) {
                    case CborValue.ByteStringVal(b) =>
                        @Expect(b.size, 32)
                        @Expect(bytesEqualCx(b, mac0.tag), true)
                    case _ => @Fail("items[3] should be ByteStringVal(tag)")
                }
            case _ => @Fail("toCborArray() should be an ArrayVal")
        }
    }

    /**
     * toCborArray().encode() must equal toCborBytes() (consistency between the
     * value form and the bytes form).
     */
    @TestCase
    func testToCborArrayEncodeEqualsToCborBytes(): Unit {
        let payload: Array<UInt8> = [0xAAu8, 0xBBu8]
        let emacKey = Array<UInt8>(32, repeat: UInt8(0x11))
        let mac0 = MdocAuthentication.makeDetachedCoseMac0(payload, emacKey)
        @Expect(bytesEqualCx(mac0.toCborArray().encode(), mac0.toCborBytes()), true)
    }
}

/* ================================================================== */
/* DigestCalculations.validateDigestsForNamespace — all branches      */
/* ================================================================== */

func buildItemCx(digestID: UInt64, elem: String): IssuerSignedItem {
    let pairs = ArrayList<(CborValue, CborValue)>()
    pairs.add((CborValue.TextStringVal("digestID"), CborValue.UInt64Val(digestID)))
    pairs.add((CborValue.TextStringVal("random"), CborValue.ByteStringVal([0x01u8, 0x02u8])))
    pairs.add((CborValue.TextStringVal("elementIdentifier"), CborValue.TextStringVal(elem)))
    pairs.add((CborValue.TextStringVal("elementValue"), CborValue.TextStringVal("v")))
    let mapBytes = CborValue.MapVal(pairs).encode()
    return IssuerSignedItem.fromCborBytes(mapBytes)
}

@Test
class ValidateDigestsForNamespaceTests {

    /**
     * Success branch: ValueDigests holds the correct SHA-256 of the item →
     * both missing and failed lists are empty.
     */
    @TestCase
    func testAllDigestsMatch(): Unit {
        let ns = "org.iso.18013.5.1"
        let item = buildItemCx(UInt64(0), "family_name")
        let correct = Digest.sha256(item.encode())

        let nsDigestMap = HashMap<UInt64, Array<UInt8>>()
        nsDigestMap.add(UInt64(0), correct)
        let vdMap = HashMap<String, DigestIDs>()
        vdMap.add(ns, DigestIDs(nsDigestMap))
        let vd = ValueDigests(vdMap)

        let items = ArrayList<IssuerSignedItem>()
        items.add(item)
        let (missing, failed) = DigestCalculations.validateDigestsForNamespace(
            ns, items, DigestAlgorithmKind.Sha256, vd
        )
        @Expect(missing.size, 0)
        @Expect(failed.size, 0)
    }

    /**
     * Failed branch: ValueDigests holds a wrong digest for the present digestID →
     * the element appears in `failed`, none in `missing`.
     */
    @TestCase
    func testWrongDigestGoesToFailed(): Unit {
        let ns = "org.iso.18013.5.1"
        let item = buildItemCx(UInt64(0), "family_name")
        let wrong: Array<UInt8> = [0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8]

        let nsDigestMap = HashMap<UInt64, Array<UInt8>>()
        nsDigestMap.add(UInt64(0), wrong)
        let vdMap = HashMap<String, DigestIDs>()
        vdMap.add(ns, DigestIDs(nsDigestMap))
        let vd = ValueDigests(vdMap)

        let items = ArrayList<IssuerSignedItem>()
        items.add(item)
        let (missing, failed) = DigestCalculations.validateDigestsForNamespace(
            ns, items, DigestAlgorithmKind.Sha256, vd
        )
        @Expect(missing.size, 0)
        @Expect(failed.size, 1)
        @Expect(failed[0], "family_name")
    }

    /**
     * Missing branch (digestID absent): the namespace exists in ValueDigests but
     * the specific digestID is not present → element goes to `missing`.
     */
    @TestCase
    func testMissingDigestIdGoesToMissing(): Unit {
        let ns = "org.iso.18013.5.1"
        let item = buildItemCx(UInt64(7), "birth_date")

        // Namespace present, but no entry for digestID 7
        let nsDigestMap = HashMap<UInt64, Array<UInt8>>()
        let vdMap = HashMap<String, DigestIDs>()
        vdMap.add(ns, DigestIDs(nsDigestMap))
        let vd = ValueDigests(vdMap)

        let items = ArrayList<IssuerSignedItem>()
        items.add(item)
        let (missing, failed) = DigestCalculations.validateDigestsForNamespace(
            ns, items, DigestAlgorithmKind.Sha256, vd
        )
        @Expect(missing.size, 1)
        @Expect(missing[0], "birth_date")
        @Expect(failed.size, 0)
    }

    /**
     * Missing branch (whole namespace absent): ValueDigests has no entry for the
     * namespace at all → every item is reported missing.
     */
    @TestCase
    func testAbsentNamespaceMarksAllMissing(): Unit {
        let ns = "org.iso.18013.5.1"
        let item = buildItemCx(UInt64(0), "given_name")

        // Empty ValueDigests → namespace lookup returns None
        let vd = ValueDigests(HashMap<String, DigestIDs>())

        let items = ArrayList<IssuerSignedItem>()
        items.add(item)
        let (missing, failed) = DigestCalculations.validateDigestsForNamespace(
            ns, items, DigestAlgorithmKind.Sha256, vd
        )
        @Expect(missing.size, 1)
        @Expect(missing[0], "given_name")
        @Expect(failed.size, 0)
    }
}

/* ================================================================== */
/* MsoValidation.validateDocType — match / mismatch                  */
/* ================================================================== */

func buildMsoCx(docType: String): MobileSecurityObject {
    let vd = ValueDigests(HashMap<String, DigestIDs>())
    let dkPairs = ArrayList<(CborValue, CborValue)>()
    dkPairs.add((CborValue.UInt64Val(UInt64(1)), CborValue.UInt64Val(UInt64(2))))
    let dki = DeviceKeyInfo(CborValue.MapVal(dkPairs), None, None)
    let vi = ValidityInfo("2024-01-01T00:00:00Z", "2024-01-01T00:00:00Z", "2035-01-01T00:00:00Z", None)
    return MobileSecurityObject(
        MobileSecurityObject.DEFAULT_VERSION,
        DigestAlgorithmKind.Sha256.stringValue(),
        vd, dki, docType, vi
    )
}

@Test
class ValidateDocTypeTests {

    /** Matching docType → None (no error). */
    @TestCase
    func testDocTypeMatches(): Unit {
        let mso = buildMsoCx("org.iso.18013.5.1.mDL")
        let errOpt = MsoValidation.validateDocType(mso, "org.iso.18013.5.1.mDL")
        @Expect(errOpt.isNone(), true)
    }

    /** Mismatching docType → Some(DocTypeNotMatches) carrying the MSO docType. */
    @TestCase
    func testDocTypeMismatch(): Unit {
        let mso = buildMsoCx("org.iso.18013.5.1.mDL")
        let errOpt = MsoValidation.validateDocType(mso, "eu.europa.ec.eudiw.pid.1")
        match (errOpt) {
            case None => @Fail("expected a docType-mismatch error")
            case Some(e) =>
                match (e.kind) {
                    case MsoValidationErrorKind.DocTypeNotMatches(dt) =>
                        @Expect(dt, "org.iso.18013.5.1.mDL")
                    case _ => @Fail("expected DocTypeNotMatches kind")
                }
        }
    }
}

/* ================================================================== */
/* SoftwareSecureArea.getStorage / unlockKey / defaultSigningAlgorithm */
/* (reuses MemorySecureKeyStorage from secure_area_test.cj)           */
/* ================================================================== */

@Test
class SoftwareSecureAreaExtraTests {

    /**
     * getStorage() returns the exact storage instance the SecureArea was built
     * with: a key batch written through the SecureArea is then visible by reading
     * the same storage slot back out.
     */
    @TestCase
    func testGetStorageReturnsBackingStore(): Unit {
        let storage = MemorySecureKeyStorage()
        let sa = SoftwareSecureArea.create(storage)
        let credOpts = CredentialOptions(CredentialPolicy.OneTimeUse, Int64(1))
        sa.createKeyBatch("gsKey", credOpts, None)

        // Same identity object back
        let got = sa.getStorage()
        // Metadata slot "<id>_meta" must hold kbiBytes after createKeyBatch
        let metaSlot = got.readKeyInfo("gsKey_meta")
        @Expect(metaSlot.contains("kbiBytes"), true)
        // Per-index slot "<id>_0" holds the x963 public key
        let keySlot = got.readKeyInfo("gsKey_0")
        @Expect(keySlot.contains("pubX963_0"), true)
        @Expect(keySlot["pubX963_0"].size, 65)
    }

    /** Software keys need no unlock → unlockKey returns None. */
    @TestCase
    func testUnlockKeyReturnsNone(): Unit {
        let storage = MemorySecureKeyStorage()
        let sa = SoftwareSecureArea.create(storage)
        @Expect(sa.unlockKey("anyId").isNone(), true)
    }

    /** P-256 default signing algorithm is ES256. */
    @TestCase
    func testDefaultSigningAlgorithmP256(): Unit {
        let storage = MemorySecureKeyStorage()
        let sa = SoftwareSecureArea.create(storage)
        let alg = sa.defaultSigningAlgorithm(CoseEcCurve.P256)
        // SigningAlgorithm has no rawValue(); use order() (ES256 == 1)
        @Expect(alg.order(), SigningAlgorithm.ES256.order())
    }

    /** P-384 / P-521 map to ES384 / ES512 via the curve helper. */
    @TestCase
    func testDefaultSigningAlgorithmOtherCurves(): Unit {
        let storage = MemorySecureKeyStorage()
        let sa = SoftwareSecureArea.create(storage)
        @Expect(sa.defaultSigningAlgorithm(CoseEcCurve.P384).order(),
            SigningAlgorithm.ES384.order())
        @Expect(sa.defaultSigningAlgorithm(CoseEcCurve.P521).order(),
            SigningAlgorithm.ES512.order())
    }
}

/* ================================================================== */
