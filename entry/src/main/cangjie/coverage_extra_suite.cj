/* ================================================================== */

@Test
class ModuleAnchorTests {

    /**
     * mdocSecurityModuleAnchor() returns Unit and must not throw. It is a
     * module-load anchor (no-op in release); calling it twice is also safe.
     */
    @TestCase
    func testAnchorIsCallable(): Unit {
        mdocSecurityModuleAnchor()
        mdocSecurityModuleAnchor()
        @Expect(true, true)
    }
}
